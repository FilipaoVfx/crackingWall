# CrackingWall — environment variables
# Copy to `.env` for local dev. In production, set these in the Cloudflare
# dashboard (Workers & Pages > Settings > Variables). NEVER commit real secrets.

# --- Public (safe to expose to the browser; PUBLIC_ prefix) ---
PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Optional public config
PUBLIC_GOOGLE_SITE_VERIFICATION=""        # Google Search Console meta token
PUBLIC_CONTACT_FUNCTION_URL=""            # contact form endpoint (Supabase Edge Function)

# --- Server-only secrets (set as Cloudflare Secrets, not plaintext vars) ---
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # server-side Supabase access
OPENROUTER_API_KEY="your-openrouter-key"            # Visual Protocol image analysis
OPENROUTER_MODEL="qwen/qwen3.6-flash"               # optional; defaults in code
RESEND_API_KEY="your-resend-key"                    # optional; transactional email
