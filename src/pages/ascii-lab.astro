---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { AsciiLab } from '../features/ascii-video';
import SEO from '../components/SEO.astro';

const title = "ASCII Lab — Convert Video to ASCII Art | CrackingWall";
const description = "Transform any video into animated ASCII art in your browser. Customize character sets, FPS and resolution. Export as GIF, MP4 or HTML. Free experimental tool.";
const canonicalUrl = "https://crakingculturewallpaperr.xyz/ascii-lab/";
---

<Layout title={title} description={description}>
  <SEO
    slot="seo"
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ASCII Lab",
    "description": description,
    "url": canonicalUrl,
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "creator": { "@type": "Organization", "name": "CrackingWall", "url": "https://crakingculturewallpaperr.xyz" }
  })} />

  <!-- Hero -->
  <section class="ascii-hero">
    <div class="ascii-hero-content">
      <span class="ascii-badge">LABS / ASCII LAB</span>
      <h1 class="ascii-title">Turn any video into ASCII art.</h1>
      <p class="ascii-subtitle">
        Upload, tweak, export as GIF / MP4 / HTML — 100% in your browser.
      </p>

      <div class="ascii-features-row">
        <span class="ascii-chip">Real-time preview</span>
        <span class="ascii-chip">Custom charsets</span>
        <span class="ascii-chip">Edge-aware</span>
        <span class="ascii-chip">GIF / MP4 / HTML</span>
      </div>
    </div>
  </section>

  <section class="ascii-tool-section">
    <AsciiLab client:only="react" />
  </section>
</Layout>

<style>
  /* Compact hero — keeps the tool above the fold */
  .ascii-hero {
    text-align: center;
    padding: 22px 20px 14px;
    background: radial-gradient(ellipse at 50% 0%, rgba(57,255,20,0.06) 0%, transparent 60%);
  }

  .ascii-hero-content {
    max-width: 650px;
    margin: 0 auto;
  }

  .ascii-badge {
    display: inline-block;
    font-family: monospace;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: #39ff14;
    border: 1px solid rgba(57,255,20,0.3);
    padding: 3px 12px;
    border-radius: 20px;
    margin-bottom: 10px;
    background: rgba(57,255,20,0.05);
  }

  .ascii-title {
    font-size: clamp(1.4rem, 3.5vw, 2rem);
    font-weight: 900;
    color: #f0f0f0;
    margin: 0 0 6px;
    line-height: 1.1;
    letter-spacing: -0.5px;
  }

  .ascii-subtitle {
    font-size: 0.85rem;
    color: #888;
    line-height: 1.4;
    margin: 0 0 12px;
  }

  .ascii-features-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }

  .ascii-chip {
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #39ff14;
    border: 1px solid rgba(57,255,20,0.2);
    padding: 3px 10px;
    border-radius: 6px;
    background: rgba(57,255,20,0.04);
  }

  .ascii-tool-section {
    border-top: 1px solid rgba(255,255,255,0.06);
  }
</style>
