---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { AsciiLab } from '../features/ascii-video';
import SEO from '../components/SEO.astro';

const title = "ASCII Lab — Convert Video to ASCII Art | CrackingWall";
const description = "Transform any video into animated ASCII art in your browser. Customize character sets, FPS and resolution. Export as GIF, MP4 or HTML. Free experimental tool.";
const canonicalUrl = "https://crakingculturewallpaperr.xyz/ascii-lab/";
---

<Layout title={title} description={description}>
  <SEO
    slot="seo"
    title={title}
    description={description}
    canonicalUrl={canonicalUrl}
  />

  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "name": "ASCII Lab",
    "description": description,
    "url": canonicalUrl,
    "applicationCategory": "MultimediaApplication",
    "operatingSystem": "Web",
    "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" },
    "creator": { "@type": "Organization", "name": "CrackingWall", "url": "https://crakingculturewallpaperr.xyz" }
  })} />

  <!-- Hero -->
  <section class="ascii-hero">
    <div class="ascii-hero-content">
      <span class="ascii-badge">LABS / ASCII LAB</span>
      <h1 class="ascii-title">Turn any video into ASCII art.</h1>
      <p class="ascii-subtitle">
        Upload a video, tweak the settings, and watch it come alive as animated character art.
        Export as GIF, MP4 or embed-ready HTML. All processing happens in your browser.
      </p>

      <!-- Live ASCII Demo -->
      <div class="ascii-hero-demo">
        <div class="ascii-hero-demo-header">
          <div class="ascii-hero-dots">
            <span class="dot dot--red"></span>
            <span class="dot dot--yellow"></span>
            <span class="dot dot--green"></span>
          </div>
          <span class="ascii-hero-demo-label">ascii-output.txt — LIVE PREVIEW</span>
        </div>
        <pre class="ascii-hero-output" id="ascii-hero-demo">##############%%%%%%%%%%###########%%%%@@@@@@@@@
################################%%%%%%%%@@@@%%%%
%#################+++#############%%%%%%%%%%%%%#
####%%%%%%#######++%%%%%%%######################
####%%%%%%%%%%%%====%%%%%%%%%%#######-#+-:-=====
---*%%%%%%%%%%-.==%%%%%%%%%%%%%%%====----=------
--=====:=%%%%%%==:%#==+-=====-=-======----------
===++++++++***=-===========-====++++++++++++++==
******************=*******%*%*******************
***************..=******* *%@@@@****************
*************+=::::-=+****+=====****************
***********************###**####################</pre>
      </div>

      <div class="ascii-features-row">
        <span class="ascii-chip">Real-time preview</span>
        <span class="ascii-chip">Custom charsets</span>
        <span class="ascii-chip">GIF / MP4 / HTML export</span>
        <span class="ascii-chip">100% client-side</span>
      </div>
    </div>
  </section>

  <section class="ascii-tool-section">
    <AsciiLab client:only="react" />
  </section>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const frames = [
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################+++#############%%%%%%%%%%%%%#\n####%%%%%%#######++%%%%%%%######################\n####%%%%%%%%%%%%====%%%%%%%%%%#######-#+-:-=====\n---*%%%%%%%%%%-.==%%%%%%%%%%%%%%%====----=------\n--=====:=%%%%%%==:%#==+-=====-=-======----------\n===++++++++***=-===========-====++++++++++++++==\n******************=*******%*%*******************\n***************..=******* *%@@@@****************\n*************+=::::-=+****+=====****************\n***********************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################-+:#############%%%%%%%%%%%%%#\n####%%%%%%#######++%#%%%%%######################\n####%%%%%%%%%%%%==+%%%%%%%%%%%#######-#+-:-=====\n---*%%%%%%%%%%-:=+=%%%%%%%%%%%%%%====---==------\n--=====:=%%%%%%==:%#==+-===+%= +======----------\n===++++++++***=-===========-% +@++++++++++++++==\n******************=*****************************\n***************:.=******************************\n*************+=::::-=+*****+++++****************\n***********************##******#################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%###############+++###############%%%%%%%%%%%%%#\n####%%%%%%######+..%%%%%%%######################\n####%%%%%%%%%%#==%%%%%-%%%%%%%#######-#+-:-=====\n--=*%%%%%%%%%-..==%=%%%%%%%%%%%%%====---==------\n--=====:=%%%%%===%%#==+======-==========--------\n===++++++++***=============-====++++++++++++++==\n****************=*=*****************************\n**************=**=****** .@@@@@%****************\n************+========*****+=====****************\n**********#************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################################%%%%%%%%%%%%%#\n%###%%%%%%#######%%+++.%%%######################\n####%%%%%%%%%%%%%%=.%=*%%%%%%%#######-#+-:-=====\n--=*%%%%%%%%%%.====.:%%%%%%%%%%%%====----=------\n--=====:=%%%%%====%%==+-=====-=-=-======--------\n===++++++++**===:==========-====++++++++++++++==\n*************.=***#=****************************\n***********=-****=******************************\n***********+=========***************************\n***********************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################################%%%%%%%%%%%%%#\n%###%%%%%%#######%%%+++%%%######################\n####%%%%%%%%%%%%%%:=.#+=.%%%%%#######-#+-:-=====\n--=*%%%%%%%%%%%=-==.%+:%%%%%%%%%%====----=------\n--=====:=%%%%%%====#+=+-=====-=-=-======--------\n===++++++++***===-=========-====++++++++++++++==\n**************=****=****************************\n***********==****=******************************\n************+========+**************************\n***********************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%############-+:##################%%%%%%%%%%%%%#\n%###%%%%%%###=+#%%%%%%%%%%######################\n####%%%%%%%===+%%%%%%%%%%%%%%%#######-#+-:-=====\n--=*%%%%%%%==:+%%%%%%%%%%%%%%%%%%====---==------\n--=====:=%%===%%%%%#+=+======-=-=-======--------\n===+++++++.=-==*++=========-====++++++++++++++==\n************=**-********************=*@ @*******\n**********==**+=********************** %@@@@****\n**********+=+++=++**********************+++*****\n***********************###**####################"
    ];
    const el = document.getElementById('ascii-hero-demo');
    if (el) {
      let i = 0;
      setInterval(() => {
        i = (i + 1) % frames.length;
        el.textContent = frames[i];
      }, 400);
    }
  });
</script>

<style>
  .ascii-hero {
    min-height: 40vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 80px 20px 40px;
    background: radial-gradient(ellipse at 50% 0%, rgba(57,255,20,0.06) 0%, transparent 60%);
  }

  .ascii-hero-content {
    max-width: 650px;
  }

  .ascii-badge {
    display: inline-block;
    font-family: monospace;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #39ff14;
    border: 1px solid rgba(57,255,20,0.3);
    padding: 6px 16px;
    border-radius: 20px;
    margin-bottom: 24px;
    background: rgba(57,255,20,0.05);
  }

  .ascii-title {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 900;
    color: #f0f0f0;
    margin: 0 0 16px;
    line-height: 1.1;
    letter-spacing: -1px;
  }

  .ascii-subtitle {
    font-size: 1.05rem;
    color: #888;
    line-height: 1.6;
    margin: 0 0 28px;
  }

  /* Hero Demo Terminal */
  .ascii-hero-demo {
    margin: 0 auto 28px;
    max-width: 520px;
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid rgba(57,255,20,0.2);
    background: #05080a;
    box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 0 20px rgba(57,255,20,0.06);
  }

  .ascii-hero-demo-header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    background: rgba(255,255,255,0.04);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }

  .ascii-hero-dots {
    display: flex;
    gap: 5px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot--red { background: #ff5f56; }
  .dot--yellow { background: #ffbd2e; }
  .dot--green { background: #27c93f; }

  .ascii-hero-demo-label {
    font-family: monospace;
    font-size: 0.6rem;
    color: #555;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .ascii-hero-output {
    font-family: 'Courier New', Courier, monospace;
    font-size: 10px;
    line-height: 1.2;
    letter-spacing: 0.5px;
    color: #39ff14;
    margin: 0;
    padding: 16px 20px;
    background: none;
    border: none;
    white-space: pre;
    overflow: hidden;
    text-shadow: 0 0 4px rgba(57,255,20,0.4);
  }

  .ascii-features-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }

  .ascii-chip {
    font-family: monospace;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.5px;
    color: #39ff14;
    border: 1px solid rgba(57,255,20,0.2);
    padding: 5px 14px;
    border-radius: 6px;
    background: rgba(57,255,20,0.04);
  }

  .ascii-tool-section {
    border-top: 1px solid rgba(255,255,255,0.06);
  }
</style>
