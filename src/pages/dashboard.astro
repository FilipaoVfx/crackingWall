---
export const prerender = true;
import AppLayout from '../layouts/AppLayout.astro';
import { WallpaperService } from '../services/wallpaperService';

// Featured wallpapers (secondary content) — prefer flagged ones, else newest
const allWallpapers = await WallpaperService.getAllWallpapers();
const featuredWallpapers = [
  ...allWallpapers.filter((w) => w.is_featured),
  ...allWallpapers.filter((w) => !w.is_featured),
].slice(0, 4);

const wallpaperHref = (w: { category: string; title: string; id: string }) =>
  `/${w.category.toLowerCase()}/${w.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${w.id}/`;

type Tool = { name: string; tag: string; desc: string; href: string; accent: 'green' | 'cyan'; icon: string };

const tools: Tool[] = [
  {
    name: 'ASCII Lab',
    tag: 'Video → ASCII',
    desc: 'Transform any video into animated ASCII art. Customize charsets, FPS and resolution.',
    href: '/ascii-lab/',
    accent: 'green',
    icon: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
  },
  {
    name: 'Visual Protocol',
    tag: 'Image → Insight',
    desc: 'Decode composition, color, lighting and hierarchy of any image like a creative director.',
    href: '/visual-protocol/',
    accent: 'cyan',
    icon: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="3" y1="12" x2="21" y2="12"/>',
  },
];

const accent: Record<string, { hoverBorder: string; hoverShadow: string; text: string; iconBox: string; tag: string }> = {
  green: {
    hoverBorder: 'hover:border-brutal-neon-green',
    hoverShadow: 'hover:shadow-neon-green',
    text: 'text-brutal-neon-green',
    iconBox: 'bg-brutal-neon-green',
    tag: 'text-brutal-neon-green border-brutal-neon-green/30 bg-brutal-neon-green/10',
  },
  cyan: {
    hoverBorder: 'hover:border-brutal-neon-cyan',
    hoverShadow: 'hover:shadow-neon-cyan',
    text: 'text-brutal-neon-cyan',
    iconBox: 'bg-brutal-neon-cyan',
    tag: 'text-brutal-neon-cyan border-brutal-neon-cyan/30 bg-brutal-neon-cyan/10',
  },
};
---

<AppLayout title="Dashboard · CrackingWall Creative Tools">
  <!-- Hero panel -->
  <section
    class="relative mb-12 overflow-hidden rounded-xl border-2 border-white/10 bg-gradient-to-br from-[#0d0f18] via-[#0a0a12] to-[#120a1e] px-8 py-12 md:px-12 md:py-14"
  >
    <!-- decorative glow + grid -->
    <div class="pointer-events-none absolute -right-20 -top-24 h-72 w-72 rounded-full bg-brutal-neon-purple/20 blur-[90px]"></div>
    <div class="pointer-events-none absolute right-10 bottom-0 h-40 w-40 rounded-full bg-brutal-neon-cyan/10 blur-[80px]"></div>

    <div class="relative max-w-2xl">
      <p class="mb-3 font-mono text-xs uppercase tracking-[0.3em] text-brutal-neon-purple">Welcome back, creative.</p>
      <h1 class="font-brutal text-4xl font-black leading-[1.05] text-white md:text-6xl">
        Your creative<br />
        <span class="bg-gradient-to-r from-brutal-neon-cyan to-brutal-neon-purple bg-clip-text text-transparent">workspace</span>
      </h1>
      <p class="mt-5 max-w-md font-mono text-sm leading-relaxed text-gray-400">
        Analyze visuals. Generate ideas. Build experiences.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="#tools"
          class="flex items-center gap-2 rounded-md border-2 border-black bg-brutal-neon-cyan px-6 py-3 font-brutal text-sm font-black uppercase tracking-wide text-black shadow-brutal-sm transition-transform hover:-translate-y-0.5"
        >
          Explore Tools
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
        <a
          href="/"
          class="flex items-center gap-2 rounded-md border-2 border-white/20 bg-white/5 px-6 py-3 font-brutal text-sm font-black uppercase tracking-wide text-white transition-colors hover:border-white/40"
        >
          Browse Wallpapers
        </a>
      </div>
    </div>
  </section>

  <!-- Tools (primary product) -->
  <section id="tools" class="mb-14 scroll-mt-24">
    <div class="mb-6 flex items-end justify-between">
      <div>
        <h2 class="font-brutal text-2xl font-black uppercase tracking-tight text-white">Your Workspace</h2>
        <p class="mt-1 font-mono text-xs text-gray-500">Free, browser-based creative tools.</p>
      </div>
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class:list={[
            'group flex flex-col rounded-xl border-2 border-white/10 bg-brutal-dark-bg p-6 transition-all hover:-translate-y-1',
            accent[tool.accent].hoverBorder,
            accent[tool.accent].hoverShadow,
          ]}
        >
          <div class="mb-5 flex items-center justify-between">
            <span
              class:list={['grid h-11 w-11 place-items-center rounded-lg border-2 border-black text-black shadow-brutal-sm', accent[tool.accent].iconBox]}
              set:html={`<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">${tool.icon}</svg>`}
            />
            <span class:list={['rounded border px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.15em]', accent[tool.accent].tag]}>
              {tool.tag}
            </span>
          </div>
          <h3 class="mb-2 font-brutal text-lg font-black uppercase tracking-wide text-white">{tool.name}</h3>
          <p class="mb-6 flex-1 font-mono text-xs leading-relaxed text-gray-400">{tool.desc}</p>
          <span class:list={['flex items-center gap-2 font-brutal text-sm font-black uppercase tracking-wide', accent[tool.accent].text]}>
            Open tool
            <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}

      <!-- Coming soon placeholder keeps the grid balanced and hints the roadmap -->
      <div class="flex flex-col items-center justify-center rounded-xl border-2 border-dashed border-white/10 p-6 text-center">
        <span class="mb-2 font-brutal text-sm font-black uppercase tracking-wide text-gray-500">More tools</span>
        <span class="font-mono text-[11px] text-gray-600">Color Engine · Motion Lab · Prompt Lab — coming soon</span>
      </div>
    </div>
  </section>

  <!-- Wallpapers (secondary) -->
  <section>
    <div class="mb-6 flex items-end justify-between">
      <div>
        <h2 class="font-brutal text-2xl font-black uppercase tracking-tight text-white">Featured Wallpapers</h2>
        <p class="mt-1 font-mono text-xs text-gray-500">Curated tech &amp; cyberpunk collection.</p>
      </div>
      <a href="/" class="shrink-0 font-mono text-xs uppercase tracking-wide text-brutal-neon-purple hover:underline">View all →</a>
    </div>

    {featuredWallpapers.length === 0 ? (
      <div class="rounded-xl border-2 border-dashed border-white/10 p-10 text-center">
        <p class="font-mono text-sm text-gray-500">No wallpapers available right now.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
        {featuredWallpapers.map((w, i) => (
          <a
            href={wallpaperHref(w)}
            class="group overflow-hidden rounded-xl border-2 border-white/10 bg-brutal-dark-bg transition-all hover:-translate-y-1 hover:border-brutal-neon-purple hover:shadow-neon-purple"
          >
            <div class="relative aspect-video overflow-hidden">
              <img
                src={w.url}
                alt={w.alt_text || w.title}
                width="400"
                height="225"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding={i < 2 ? 'sync' : 'async'}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 transition-opacity group-hover:opacity-100">
                <span class="font-brutal text-sm font-black uppercase tracking-widest text-brutal-neon-cyan">View</span>
              </div>
            </div>
            <div class="flex items-center justify-between gap-2 px-3 py-2.5">
              <h3 class="truncate font-brutal text-xs font-bold uppercase tracking-wide text-white">{w.title}</h3>
              <span class="shrink-0 font-mono text-[10px] text-gray-500">❤️ {w.likes}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</AppLayout>
