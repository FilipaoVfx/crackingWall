---
export const prerender = true;
import AppLayout from '../layouts/AppLayout.astro';
import { WallpaperService } from '../services/wallpaperService';

// Featured wallpapers (secondary content) — prefer flagged ones, else newest
const allWallpapers = await WallpaperService.getAllWallpapers();
const featuredWallpapers = [
  ...allWallpapers.filter((w) => w.is_featured),
  ...allWallpapers.filter((w) => !w.is_featured),
].slice(0, 4);

const wallpaperHref = (w: { category: string; title: string; id: string }) =>
  `/${w.category.toLowerCase()}/${w.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${w.id}/`;

const tools = [
  {
    name: 'ASCII Lab',
    tag: 'Video → ASCII',
    desc: 'Transform any video into animated ASCII art. Customize charsets, FPS and resolution.',
    href: '/ascii-lab/',
    accent: 'green',
  },
  {
    name: 'Visual Protocol',
    tag: 'Image → Insight',
    desc: 'Decode composition, color, lighting and hierarchy of any image like a creative director.',
    href: '/visual-protocol/',
    accent: 'cyan',
  },
];

const accentClasses: Record<string, { border: string; text: string; tag: string }> = {
  green: {
    border: 'hover:border-brutal-neon-green hover:shadow-neon-green',
    text: 'text-brutal-neon-green',
    tag: 'text-brutal-neon-green border-brutal-neon-green/30 bg-brutal-neon-green/10',
  },
  cyan: {
    border: 'hover:border-brutal-neon-cyan hover:shadow-neon-cyan',
    text: 'text-brutal-neon-cyan',
    tag: 'text-brutal-neon-cyan border-brutal-neon-cyan/30 bg-brutal-neon-cyan/10',
  },
};
---

<AppLayout title="Dashboard · CrackingWall Creative Tools">
  <!-- Welcome -->
  <section class="mb-10">
    <p class="mb-2 font-mono text-xs uppercase tracking-[0.25em] text-brutal-neon-purple">Welcome back, creative.</p>
    <h1 class="font-brutal text-4xl font-black leading-tight text-white md:text-5xl">
      Your creative <span class="text-brutal-neon-cyan">workspace</span>
    </h1>
    <p class="mt-3 max-w-xl font-mono text-sm text-gray-400">
      Analyze visuals. Generate ideas. Build experiences.
    </p>
  </section>

  <!-- Tools (primary) -->
  <section class="mb-14">
    <div class="mb-5 flex items-center justify-between">
      <h2 class="font-brutal text-xl font-black uppercase tracking-wide text-white">Creative Tools</h2>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((tool) => (
        <a
          href={tool.href}
          class:list={[
            'group flex flex-col rounded-lg border-2 border-white/10 bg-brutal-dark-bg p-6 transition-all hover:-translate-y-1',
            accentClasses[tool.accent].border,
          ]}
        >
          <span
            class:list={[
              'mb-4 w-fit rounded border px-2.5 py-1 font-mono text-[10px] font-bold uppercase tracking-[0.15em]',
              accentClasses[tool.accent].tag,
            ]}
          >
            {tool.tag}
          </span>
          <h3 class="mb-2 font-brutal text-lg font-black uppercase tracking-wide text-white">{tool.name}</h3>
          <p class="mb-5 flex-1 font-mono text-xs leading-relaxed text-gray-400">{tool.desc}</p>
          <span class:list={['flex items-center gap-2 font-brutal text-sm font-black uppercase tracking-wide', accentClasses[tool.accent].text]}>
            Open tool
            <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Wallpapers (secondary) -->
  <section>
    <div class="mb-5 flex items-center justify-between">
      <h2 class="font-brutal text-xl font-black uppercase tracking-wide text-white">Featured Wallpapers</h2>
      <a href="/" class="font-mono text-xs uppercase tracking-wide text-brutal-neon-purple hover:underline">View all →</a>
    </div>
    {featuredWallpapers.length === 0 ? (
      <div class="rounded-lg border-2 border-dashed border-white/10 p-10 text-center">
        <p class="font-mono text-sm text-gray-500">No wallpapers available right now.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 gap-5 lg:grid-cols-4">
        {featuredWallpapers.map((w, i) => (
          <a
            href={wallpaperHref(w)}
            class="group overflow-hidden rounded-lg border-2 border-white/10 bg-brutal-dark-bg transition-all hover:-translate-y-1 hover:border-brutal-neon-purple hover:shadow-neon-purple"
          >
            <div class="relative aspect-video overflow-hidden">
              <img
                src={w.url}
                alt={w.alt_text || w.title}
                width="400"
                height="225"
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding={i < 2 ? 'sync' : 'async'}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 transition-opacity group-hover:opacity-100">
                <span class="font-brutal text-sm font-black uppercase tracking-widest text-brutal-neon-cyan">View</span>
              </div>
            </div>
            <div class="flex items-center justify-between gap-2 px-3 py-2.5">
              <h3 class="truncate font-brutal text-xs font-bold uppercase tracking-wide text-white">{w.title}</h3>
              <span class="shrink-0 font-mono text-[10px] text-gray-500">❤️ {w.likes}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</AppLayout>
