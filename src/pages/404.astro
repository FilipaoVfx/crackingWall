---
export const prerender = true;
import AppLayout from '../layouts/AppLayout.astro';

const links = [
  { href: '/', label: 'Home', hover: 'hover:text-brutal-neon-cyan' },
  { href: '/3d-lab/', label: '3D Lab', hover: 'hover:text-brutal-neon-yellow' },
  { href: '/ascii-lab/', label: 'ASCII Lab', hover: 'hover:text-brutal-neon-green' },
  { href: '/visual-protocol/', label: 'Visual Protocol', hover: 'hover:text-brutal-neon-pink' },
  { href: '/wallpapers/', label: 'Wallpapers', hover: 'hover:text-brutal-neon-purple' },
  { href: '/blog/', label: 'Blog', hover: 'hover:text-brutal-neon-cyan' },
];
---

<AppLayout
  title="404 — Signal Lost | Pixelatmos"
  description="The page you're looking for doesn't exist. Head back to Pixelatmos's tools, wallpapers, or blog."
  noindex={true}
>
  <div class="mx-auto flex max-w-2xl flex-col items-center px-4 py-24 text-center">
    <p class="font-brutal text-7xl font-black tracking-tight text-brutal-neon-pink drop-shadow-[3px_3px_0_#00fff9] md:text-9xl">
      404
    </p>
    <h1 class="mt-4 font-brutal text-2xl font-black uppercase tracking-wide text-white md:text-3xl">
      Signal Lost
    </h1>
    <p class="mt-3 font-mono text-sm text-gray-400">
      This route doesn't resolve. The page may have moved, or the link is broken.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-x-6 gap-y-3 font-brutal text-xs font-black uppercase tracking-wider">
      {links.map((l) => (
        <a href={l.href} class:list={['text-gray-400 transition-colors', l.hover]}>
          {l.label}
        </a>
      ))}
    </div>

    <a
      href="/"
      class="mt-12 inline-block border-2 border-brutal-neon-cyan px-6 py-3 font-brutal text-sm font-black uppercase tracking-wider text-brutal-neon-cyan transition-colors hover:bg-brutal-neon-cyan hover:text-black"
    >
      ← Back to Home
    </a>
  </div>
</AppLayout>
