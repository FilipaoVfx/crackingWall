---
export const prerender = true;
import AppLayout from '../layouts/AppLayout.astro';

const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://crakingculturewallpaperr.xyz';

// About-page structured data: identify the creator (E-E-A-T) + the page itself.
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'About CrackingWall',
  url: `${siteURL}/about/`,
  mainEntity: {
    '@type': 'Person',
    name: 'FilipaoVfx',
    url: 'https://github.com/FilipaoVfx',
    image: `${siteURL}/filipaovfx-avatar.png`,
    jobTitle: 'Independent developer & digital artist',
    description:
      'Independent developer and digital artist behind CrackingWall — builder of its browser-based creative tools and curator of its tech-culture wallpaper gallery.',
    sameAs: ['https://github.com/FilipaoVfx'],
  },
};
---

<AppLayout
  title="About CrackingWall — Who We Are & How We Work"
  description="CrackingWall is an independent creative-tools studio and curated tech-culture gallery. Meet the creator, our editorial standards, and how we use AI transparently."
>
  <script type="application/ld+json" set:html={JSON.stringify(aboutSchema)} />
  <div class="about-container">
    <div class="content-wrapper">
      <h1 class="glitch-title">About CrackingWall</h1>

      <div class="text-content">
        <p class="lead">
          CrackingWall is an independent studio at the intersection of <strong>software and
          visual culture</strong>. We build free, browser-based creative tools and curate a
          focused gallery of tech-culture wallpapers — cyberpunk, futuristic, glitch, and
          developer-culture aesthetics. Everything here is made with intent, not scraped or
          mass-produced.
        </p>

        <h2 class="first-heading">Who's Behind CrackingWall</h2>
        <div class="creator-card">
          <img
            class="creator-avatar"
            src="/filipaovfx-avatar.png"
            width="96"
            height="96"
            alt="FilipaoVfx, creator of CrackingWall"
            loading="lazy"
          />
          <div class="creator-meta">
            <span class="creator-name">FilipaoVfx</span>
            <span class="creator-role">Independent developer &amp; digital artist</span>
            <a class="creator-link" href="https://github.com/FilipaoVfx" rel="noopener noreferrer" target="_blank">
              github.com/FilipaoVfx
            </a>
          </div>
        </div>
        <p>
          CrackingWall is a solo project by <strong>FilipaoVfx</strong> — an independent
          developer and digital artist. The same person writes the code for the creative
          tools, designs the visual identity, and curates every wallpaper in the gallery.
          It is an author-led project, not an anonymous content farm.
        </p>
        <p>
          You can see the engineering work in the open: the tools are built on original
          code, and the 3D Lab engine is published as an open-source package. Reach the
          creator directly on
          <a href="https://github.com/FilipaoVfx" rel="noopener noreferrer" target="_blank">GitHub</a>
          or through the <a href="/contact/">contact page</a>.
        </p>

        <h2>What We Actually Build</h2>
        <p>
          The heart of CrackingWall is a small suite of <strong>original, browser-based
          creative tools</strong> — real software, written by us, that runs entirely on
          your device:
        </p>
        <ul>
          <li><strong><a href="/ascii-lab/">ASCII Lab</a></strong> — convert images and video into ASCII art with tunable character sets and rendering logic.</li>
          <li><strong><a href="/visual-protocol/">Visual Protocol</a></strong> — analyze and decode visuals into structured creative direction.</li>
          <li><strong><a href="/3d-lab/">3D Lab</a></strong> — turn text or an SVG into an interactive 3D object you can sculpt and export (PNG/GLB), powered by our open-source <em>@filipaovfx/svg3d</em> package.</li>
        </ul>
        <p>
          These tools are the original, hands-on value of the site — not a wrapper around
          someone else's product. The wallpaper gallery complements them with a cohesive
          visual world for the same audience.
        </p>

        <h2>Our Editorial Standards</h2>
        <p>
          We publish on a curation-first principle: fewer things, done well. Every
          wallpaper is selected and refined against a written aesthetic manifesto tracking
          movements like Code Brutalism, Retro-Hardware, and Technical Vaporwave. Concretely,
          that means we:
        </p>
        <ul>
          <li>curate for visual coherence rather than volume;</li>
          <li>refine composition, contrast, and color for real desktop usability (1080p, 1440p, 4K, ultrawide);</li>
          <li>reject anything that doesn't add to the collection's identity;</li>
          <li>write our own descriptions and context instead of auto-generating filler.</li>
        </ul>

        <h2>How the Wallpapers Are Made</h2>
        <p>
          Our gallery is <strong>original generative art</strong>, created in-house as
          vector compositions and rendered to high-resolution files with our own code — not
          stock photos, and not third-party downloads. Each piece is designed around the
          same aesthetic manifesto that guides the rest of the site, so the collection stays
          coherent instead of being a grab-bag of borrowed images.
        </p>
        <p>
          We're also transparent about tooling: we use AI as an assistant for ideation and
          for building our software, but what we publish in the gallery is our own work,
          refined by hand until it meets our standards. We don't republish stock imagery as
          if it were ours, and we don't ship raw, unreviewed output.
        </p>

        <h2>Who It's For</h2>
        <p>
          CrackingWall is built for developers, designers, gamers, and digital creators —
          anyone who treats their desktop and their tools as part of their identity.
        </p>

        <div class="disclaimer-box">
          <h3>⚠️ Content Clarification</h3>
          <p>
            CrackingWall features fictional digital artwork inspired by cyberpunk
            aesthetics, speculative technology, and digital environments.
          </p>
          <p class="mt-4">
            All terminology related to systems, glitches, or digital disruption is purely
            artistic and metaphorical — a celebration of software development and network
            engineering culture.
          </p>
        </div>

        <h2>Mission</h2>
        <p>
          To turn digital workspaces into intentional environments — through original
          creative tools and a curated visual world built on depth, cohesion, and identity,
          not mass aggregation.
        </p>
      </div>
    </div>
  </div>
</AppLayout>

<style>
  .about-container {
    min-height: 80vh;
    display: flex;
    justify-content: center;
    padding: 60px 20px;
    background: #0a0a0f;
    color: #f0f0f0;
  }

  .content-wrapper {
    max-width: 800px;
    width: 100%;
  }

  .glitch-title {
    font-size: clamp(2.5rem, 5vw, 4rem);
    font-weight: 900;
    margin-bottom: 2rem;
    color: #f0f0f0;
    text-shadow: 2px 2px 0px #b026ff, -2px -2px 0px #00fff9;
  }

  .text-content {
    background: #121218;
    border: 1px solid #333;
    padding: 40px;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .lead {
    font-size: 1.25rem;
    color: #d0d0d0;
    line-height: 1.7;
  }

  .creator-card {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin: 0 0 1.75rem;
    padding: 1.25rem;
    background: #0d0d13;
    border: 1px solid #2a2a35;
    border-left: 4px solid #00fff9;
    border-radius: 6px;
  }

  .creator-avatar {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: 2px solid #00fff9;
    box-shadow: 0 0 16px rgba(0, 255, 249, 0.25);
    flex-shrink: 0;
  }

  .creator-meta {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .creator-name {
    font-size: 1.4rem;
    font-weight: 900;
    color: #f0f0f0;
  }

  .creator-role {
    font-size: 0.95rem;
    color: #a0a0a0;
  }

  .creator-link {
    font-family: monospace;
    font-size: 0.85rem;
    color: #00fff9;
    text-decoration: none;
    margin-top: 0.25rem;
  }

  .creator-link:hover {
    color: #b026ff;
  }

  h2 {
    color: #00fff9;
    font-size: 1.8rem;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    font-weight: 800;
  }

  p {
    line-height: 1.8;
    color: #a0a0a0;
    margin-bottom: 1.5rem;
    font-size: 1.1rem;
  }

  strong {
    color: #f0f0f0;
  }

  a {
    color: #00fff9;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  a:hover {
    color: #b026ff;
  }

  ul {
    list-style-type: disc;
    padding-left: 20px;
    margin-bottom: 1.5rem;
    color: #a0a0a0;
  }

  li {
    margin-bottom: 0.5rem;
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .disclaimer-box {
    margin: 3rem 0;
    padding: 2rem;
    border: 2px solid #b026ff;
    background: rgba(176, 38, 255, 0.05);
    border-radius: 6px;
  }

  .disclaimer-box h3 {
    margin-top: 0;
    color: #b026ff;
    font-size: 1.4rem;
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1rem;
  }

  .disclaimer-box p {
    margin-bottom: 0;
    color: #d0d0d0;
  }

  .first-heading {
    margin-top: 0;
  }

  .mt-4 {
    margin-top: 1rem;
  }
</style>
