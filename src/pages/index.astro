---
export const prerender = true;
import AppLayout from '../layouts/AppLayout.astro';
import { WallpaperService } from '../services/wallpaperService';
import { wallpaperPath } from '../utils/wallpaper';

// Wallpapers — secondary content, kept for SEO depth + internal linking
const allWallpapers = await WallpaperService.getAllWallpapers();
const featuredWallpapers = [
  ...allWallpapers.filter((w) => w.is_featured),
  ...allWallpapers.filter((w) => !w.is_featured),
].slice(0, 8);
const categories = [...new Set(allWallpapers.map((w) => w.category))].slice(0, 8);

const wallpaperHref = wallpaperPath;

// Real social proof — aggregate totals from the gallery data (no inflated numbers).
const totalDownloads = allWallpapers.reduce((s, w) => s + (w.downloads || 0), 0);
const totalLikes = allWallpapers.reduce((s, w) => s + (w.likes || 0), 0);
const wallpaperCount = allWallpapers.length;
const stats = [
  { value: '3', label: 'Free tools' },
  { value: wallpaperCount.toLocaleString(), label: 'Original wallpapers' },
  { value: totalDownloads.toLocaleString(), label: 'Downloads' },
  { value: totalLikes.toLocaleString(), label: 'Likes' },
];
---

<AppLayout
  title="Pixelatmos — Creative Tools for Designers, Developers & Digital Artists"
  description="Free browser-based creative tools: turn SVG and text into interactive 3D, convert video to ASCII art, and decode any image's composition, color and lighting. Plus a curated tech & cyberpunk wallpaper collection."
>
  <!-- Compact hero — glitch headline, dense -->
  <section class="relative mb-8 overflow-hidden border-2 border-black bg-brutal-dark-bg px-6 py-6 shadow-brutal md:px-8">
    <div class="pointer-events-none absolute -right-16 -top-16 h-48 w-48 bg-brutal-neon-purple/20 blur-[80px]"></div>
    <div class="relative flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
      <div>
        <p class="mb-1.5 font-mono text-[10px] uppercase tracking-[0.3em] text-brutal-neon-purple">Welcome back, creative.</p>
        <h1
          class="glitch-head font-brutal text-2xl font-black uppercase leading-none text-white md:text-3xl"
          data-text="Your creative workspace"
        >
          Your creative workspace
        </h1>
        <p class="mt-2 font-mono text-xs text-gray-400">Analyze visuals · Generate ideas · Build experiences.</p>
      </div>
      <div class="flex shrink-0 gap-3">
        <a
          href="#tools"
          class="flex items-center gap-2 border-2 border-black bg-brutal-neon-cyan px-4 py-2.5 font-brutal text-xs font-black uppercase tracking-wide text-black shadow-brutal-sm transition-transform hover:-translate-y-0.5"
        >
          Explore Tools →
        </a>
      </div>
    </div>
  </section>

  <!-- Social proof — real aggregate totals -->
  <section class="mb-10 grid grid-cols-2 gap-3 md:grid-cols-4">
    {stats.map((s) => (
      <div class="border-2 border-black bg-brutal-dark-bg px-4 py-3 text-center shadow-brutal-sm">
        <div class="font-brutal text-2xl font-black tracking-tight text-brutal-neon-cyan md:text-3xl">{s.value}</div>
        <div class="mt-0.5 font-mono text-[10px] uppercase tracking-wider text-gray-500">{s.label}</div>
      </div>
    ))}
  </section>

  <!-- Tools (primary) — each with a descriptive visual preview -->
  <section id="tools" class="mb-12 scroll-mt-24">
    <h2 class="mb-1 font-brutal text-xl font-black uppercase tracking-tight text-white">Your Workspace</h2>
    <p class="mb-5 font-mono text-[11px] text-gray-500">Free, browser-based creative tools. Nothing to install, no signup.</p>

    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      <!-- 3D Lab — flagship tool, listed first -->
      <a
        href="/3d-lab/"
        class="group flex flex-col border-2 border-black bg-brutal-dark-bg shadow-brutal transition-all hover:-translate-y-1 hover:shadow-neon-yellow"
      >
        <div class="relative flex h-36 items-center justify-center overflow-hidden border-b-2 border-black bg-[#070a0f]">
          <svg class="cube-spin" xmlns="http://www.w3.org/2000/svg" width="86" height="86" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-label="Rotating 3D cube preview">
            <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
            <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
            <line x1="12" y1="22.08" x2="12" y2="12"/>
          </svg>
          <span class="pointer-events-none absolute right-3 top-3 h-2 w-2 animate-pulse bg-brutal-neon-yellow"></span>
        </div>
        <div class="flex flex-1 flex-col p-5">
          <span class="mb-2 w-fit border border-brutal-neon-yellow/30 bg-brutal-neon-yellow/10 px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-brutal-neon-yellow">SVG → 3D</span>
          <h3 class="mb-1.5 font-brutal text-lg font-black uppercase tracking-wide text-white">3D Lab</h3>
          <p class="mb-4 flex-1 font-mono text-[11px] leading-relaxed text-gray-400">Turn any SVG or short text into an interactive 3D object. Sculpt each layer's depth and material, then export PNG or GLB.</p>
          <span class="flex items-center gap-2 font-brutal text-xs font-black uppercase tracking-wide text-brutal-neon-yellow">
            Open tool
            <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>

      <!-- ASCII Lab -->
      <a
        href="/ascii-lab/"
        class="group flex flex-col border-2 border-black bg-brutal-dark-bg shadow-brutal transition-all hover:-translate-y-1 hover:shadow-neon-green"
      >
        <div class="relative flex h-36 items-center justify-center overflow-hidden border-b-2 border-black bg-[#070a0f]">
          <pre id="ascii-demo" class="ascii-demo" aria-label="Live ASCII art preview"></pre>
          <span class="pointer-events-none absolute right-3 top-3 h-2 w-2 animate-pulse bg-brutal-neon-green"></span>
        </div>
        <div class="flex flex-1 flex-col p-5">
          <span class="mb-2 w-fit border border-brutal-neon-green/30 bg-brutal-neon-green/10 px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-brutal-neon-green">Video → ASCII</span>
          <h3 class="mb-1.5 font-brutal text-lg font-black uppercase tracking-wide text-white">ASCII Lab</h3>
          <p class="mb-4 flex-1 font-mono text-[11px] leading-relaxed text-gray-400">Turn any video into animated ASCII art. Custom charsets, FPS and resolution. Export GIF/MP4/HTML.</p>
          <span class="flex items-center gap-2 font-brutal text-xs font-black uppercase tracking-wide text-brutal-neon-green">
            Open tool
            <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>

      <!-- Visual Protocol -->
      <a
        href="/visual-protocol/"
        class="group flex flex-col border-2 border-black bg-brutal-dark-bg shadow-brutal transition-all hover:-translate-y-1 hover:shadow-neon-cyan"
      >
        <div class="relative flex h-36 items-center justify-center overflow-hidden border-b-2 border-black bg-[#070a0f] px-8">
          <div class="vp-mock w-full max-w-[240px]">
            <div class="vp-row"><span class="vp-label">Composition</span><span class="vp-bar"><span class="vp-fill" style="width:85%"></span></span></div>
            <div class="vp-row"><span class="vp-label">Color harmony</span><span class="vp-bar"><span class="vp-fill" style="width:72%"></span></span></div>
            <div class="vp-row"><span class="vp-label">Lighting</span><span class="vp-bar"><span class="vp-fill" style="width:91%"></span></span></div>
            <div class="vp-row"><span class="vp-label">Hierarchy</span><span class="vp-bar"><span class="vp-fill" style="width:64%"></span></span></div>
          </div>
        </div>
        <div class="flex flex-1 flex-col p-5">
          <span class="mb-2 w-fit border border-brutal-neon-cyan/30 bg-brutal-neon-cyan/10 px-2 py-0.5 font-mono text-[10px] font-bold uppercase tracking-[0.15em] text-brutal-neon-cyan">Image → Insight</span>
          <h3 class="mb-1.5 font-brutal text-lg font-black uppercase tracking-wide text-white">Visual Protocol</h3>
          <p class="mb-4 flex-1 font-mono text-[11px] leading-relaxed text-gray-400">Decode composition, color, lighting and hierarchy of any image like a creative director.</p>
          <span class="flex items-center gap-2 font-brutal text-xs font-black uppercase tracking-wide text-brutal-neon-cyan">
            Open tool
            <svg class="transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- Wallpapers (secondary, SEO depth) -->
  <section>
    <div class="mb-4 flex items-end justify-between">
      <div>
        <h2 class="font-brutal text-xl font-black uppercase tracking-tight text-white">Featured Wallpapers</h2>
        <p class="mt-1 font-mono text-[11px] text-gray-500">Curated tech &amp; cyberpunk collection.</p>
      </div>
      <a href="/wallpapers/" class="shrink-0 font-mono text-[11px] uppercase tracking-wide text-brutal-neon-purple hover:underline">View all →</a>
    </div>

    <!-- Category quick-links (internal linking for SEO) -->
    {categories.length > 0 && (
      <div class="mb-5 flex flex-wrap gap-2">
        {categories.map((cat) => (
          <a
            href={`/${cat.toLowerCase()}/`}
            class="border-2 border-white/15 px-3 py-1 font-mono text-[10px] font-bold uppercase tracking-wide text-gray-300 transition-colors hover:border-brutal-neon-cyan hover:text-brutal-neon-cyan"
          >
            {cat}
          </a>
        ))}
      </div>
    )}

    {featuredWallpapers.length === 0 ? (
      <div class="border-2 border-dashed border-white/15 p-10 text-center">
        <p class="font-mono text-sm text-gray-500">No wallpapers available right now.</p>
      </div>
    ) : (
      <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
        {featuredWallpapers.map((w, i) => (
          <a
            href={wallpaperHref(w)}
            class="group overflow-hidden border-2 border-black bg-brutal-dark-bg shadow-brutal-sm transition-all hover:-translate-y-1 hover:shadow-neon-purple"
          >
            <div class="relative aspect-video overflow-hidden border-b-2 border-black">
              <img
                src={w.url}
                alt={w.alt_text || w.title}
                width="400"
                height="225"
                loading={i < 4 ? 'eager' : 'lazy'}
                decoding={i < 4 ? 'sync' : 'async'}
                class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
              />
              <div class="absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 transition-opacity group-hover:opacity-100">
                <span class="font-brutal text-sm font-black uppercase tracking-widest text-brutal-neon-cyan">View</span>
              </div>
            </div>
            <div class="flex items-center justify-between gap-2 px-3 py-2">
              <h3 class="truncate font-brutal text-[11px] font-bold uppercase tracking-wide text-white">{w.title}</h3>
              <span class="shrink-0 font-mono text-[10px] text-gray-500">❤️ {w.likes}</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</AppLayout>

<style>
  /* Multicolor RGB-split glitch headline (neobrutalism glitch) */
  .glitch-head {
    position: relative;
    text-shadow: 2px 0 #ff0080, -2px 0 #00fff9;
  }
  .glitch-head::before,
  .glitch-head::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .glitch-head::before {
    color: #00fff9;
    clip-path: inset(0 0 55% 0);
    animation: glitch-top 3.2s infinite steps(2);
  }
  .glitch-head::after {
    color: #ff0080;
    clip-path: inset(55% 0 0 0);
    animation: glitch-bottom 2.6s infinite steps(2);
  }
  @keyframes glitch-top {
    0%, 92%, 100% { transform: translate(0); }
    94% { transform: translate(-3px, -1px); }
    96% { transform: translate(2px, 1px); }
  }
  @keyframes glitch-bottom {
    0%, 90%, 100% { transform: translate(0); }
    93% { transform: translate(3px, 1px); }
    97% { transform: translate(-2px, -1px); }
  }

  /* ASCII live preview */
  .ascii-demo {
    margin: 0;
    font-family: 'Courier New', monospace;
    font-size: 7px;
    line-height: 1.12;
    letter-spacing: 0.5px;
    color: #39ff14;
    text-align: center;
    white-space: pre;
    opacity: 0.7;
    text-shadow: 0 0 3px rgba(57, 255, 20, 0.4);
    transition: opacity 0.3s;
  }
  .group:hover .ascii-demo { opacity: 1; }

  /* Visual Protocol bars preview */
  .vp-mock { display: flex; flex-direction: column; gap: 9px; opacity: 0.75; transition: opacity 0.3s; }
  .group:hover .vp-mock { opacity: 1; }
  .vp-row { display: flex; flex-direction: column; gap: 3px; }
  .vp-label { font-family: monospace; font-size: 8px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; color: #5a6472; }
  .vp-bar { height: 5px; background: rgba(255, 255, 255, 0.07); overflow: hidden; }
  .vp-fill { display: block; height: 100%; background: linear-gradient(90deg, #00fff9, #0088ff); }

  /* 3D Lab wireframe cube preview */
  .cube-spin {
    color: #ffed00;
    opacity: 0.7;
    filter: drop-shadow(0 0 8px rgba(255, 237, 0, 0.35));
    transition: opacity 0.3s;
    animation: cube-tilt 7s ease-in-out infinite;
  }
  .group:hover .cube-spin { opacity: 1; }
  @keyframes cube-tilt {
    0%, 100% { transform: rotate(-9deg) scale(1); }
    50%      { transform: rotate(9deg) scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cube-spin { animation: none; }
  }
</style>

<script>
  // ASCII demo — real frames from a video conversion
  const asciiFrames = [
    "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################+++#############%%%%%%%%%%%%%#\n####%%%%%%#######++%%%%%%%######################\n####%%%%%%%%%%%%====%%%%%%%%%%#######-#+-:-=====\n---*%%%%%%%%%%-.==%%%%%%%%%%%%%%%====----=------\n--=====:=%%%%%%==:%#==+-=====-=-======----------\n===++++++++***=-===========-====++++++++++++++==\n******************=*******%*%*******************\n***************..=******* *%@@@@****************\n*************+=::::-=+****+=====****************\n***********************###**####################",
    "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################-+:#############%%%%%%%%%%%%%#\n####%%%%%%#######++%#%%%%%######################\n####%%%%%%%%%%%%==+%%%%%%%%%%%#######-#+-:-=====\n---*%%%%%%%%%%-:=+=%%%%%%%%%%%%%%====---==------\n--=====:=%%%%%%==:%#==+-===+%= +======----------\n===++++++++***=-===========-% +@++++++++++++++==\n******************=*****************************\n***************:.=******************************\n*************+=::::-=+*****+++++****************\n***********************##******#################",
    "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%###############+++###############%%%%%%%%%%%%%#\n####%%%%%%######+..%%%%%%%######################\n####%%%%%%%%%%#==%%%%%-%%%%%%%#######-#+-:-=====\n--=*%%%%%%%%%-..==%=%%%%%%%%%%%%%====---==------\n--=====:=%%%%%===%%#==+======-==========--------\n===++++++++***=============-====++++++++++++++==\n****************=*=*****************************\n**************=**=****** .@@@@@%****************\n************+========*****+=====****************\n**********#************###**####################",
    "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################################%%%%%%%%%%%%%#\n%###%%%%%%#######%%+++.%%%######################\n####%%%%%%%%%%%%%%=.%=*%%%%%%%#######-#+-:-=====\n--=*%%%%%%%%%%.====.:%%%%%%%%%%%%====----=------\n--=====:=%%%%%====%%==+-=====-=-=-======--------\n===++++++++**===:==========-====++++++++++++++==\n*************.=***#=****************************\n***********=-****=******************************\n***********+=========***************************\n***********************###**####################"
  ];
  const el = document.getElementById('ascii-demo');
  if (el) {
    el.textContent = asciiFrames[0];
    let i = 0;
    setInterval(() => { i = (i + 1) % asciiFrames.length; el.textContent = asciiFrames[i]; }, 420);
  }
</script>
