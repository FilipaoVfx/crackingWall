---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import { WallpaperService } from '../services/wallpaperService';
import '../styles/home.css';

// Fetch wallpapers for display
const allWallpapers = await WallpaperService.getAllWallpapers();
const displayWallpapers = allWallpapers.slice(0, 30); // Show first 30

// Extract unique categories from actual data
const uniqueCategories = [...new Set(allWallpapers.map(w => w.category))];
---

<Layout title="CrackingWall - Tech Culture Wallpapers">
  <!-- Hero Section -->
  

  <!-- Design Tools CTA -->
  <section class="tools-section">
    <div class="tools-header">
      <span class="tools-badge">LABS</span>
      <h2 class="tools-title">Design tools for the curious</h2>
      <p class="tools-subtitle">Experimental creative tools — free, browser-based, no sign-up required.</p>
    </div>

    <div class="tools-grid">
      <!-- ASCII Lab Card -->
      <a href="/ascii-lab/" class="tool-card tool-card--ascii">
        <div class="tool-card__preview">
          <pre class="ascii-demo" id="ascii-demo" aria-label="Live ASCII art demo from a real video conversion">##############%%%%%%%%%%###########%%%%@@@@@@@@@
################################%%%%%%%%@@@@%%%%
%#################+++#############%%%%%%%%%%%%%#
####%%%%%%#######++%%%%%%%######################
####%%%%%%%%%%%%====%%%%%%%%%%#######-#+-:-=====
---*%%%%%%%%%%-.==%%%%%%%%%%%%%%%====----=------
--=====:=%%%%%%==:%#==+-=====-=-======----------
===++++++++***=-===========-====++++++++++++++==
******************=*******%*%*******************
***************..=******* *%@@@@****************
*************+=::::-=+****+=====****************
***********************###**####################</pre>
          <div class="tool-card__glow tool-card__glow--green"></div>
        </div>
        <div class="tool-card__body">
          <div class="tool-card__tag tool-card__tag--green">VIDEO &rarr; ASCII</div>
          <h3 class="tool-card__title">ASCII Lab</h3>
          <p class="tool-card__desc">Transform any video into animated ASCII art. Customize charsets, FPS and resolution. Export as GIF, MP4 or HTML.</p>
          <span class="tool-card__cta tool-card__cta--green">
            Open tool
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>

      <!-- Visual Protocol Card -->
      <a href="/visual-protocol/" class="tool-card tool-card--vp">
        <div class="tool-card__preview">
          <div class="vp-preview-mock">
            <div class="vp-bar-group">
              <div class="vp-label">Composition</div>
              <div class="vp-bar"><div class="vp-bar-fill" style="width:85%"></div></div>
            </div>
            <div class="vp-bar-group">
              <div class="vp-label">Color harmony</div>
              <div class="vp-bar"><div class="vp-bar-fill" style="width:72%"></div></div>
            </div>
            <div class="vp-bar-group">
              <div class="vp-label">Lighting</div>
              <div class="vp-bar"><div class="vp-bar-fill" style="width:91%"></div></div>
            </div>
            <div class="vp-bar-group">
              <div class="vp-label">Hierarchy</div>
              <div class="vp-bar"><div class="vp-bar-fill" style="width:68%"></div></div>
            </div>
          </div>
          <div class="tool-card__glow tool-card__glow--cyan"></div>
        </div>
        <div class="tool-card__body">
          <div class="tool-card__tag tool-card__tag--cyan">IMAGE &rarr; INSIGHT</div>
          <h3 class="tool-card__title">Visual Protocol</h3>
          <p class="tool-card__desc">Decode the visual language of any image. Understand composition, color, lighting and hierarchy like a creative director.</p>
          <span class="tool-card__cta tool-card__cta--cyan">
            Open tool
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </span>
        </div>
      </a>
    </div>
  </section>

  <!-- Category Filters -->
  <section class="filters-section">
    <div class="filters-container">
      <button class="filter-btn active" data-category="all">
        ALL
      </button>
      {uniqueCategories.map((category) => (
        <button class="filter-btn" data-category={category.toLowerCase()}>
          {category.toUpperCase()}
        </button>
      ))}
    </div>
  </section>

  <!-- Wallpapers Grid -->
  <section class="wallpapers-section">
    <div class="wallpapers-grid" id="wallpapers-grid">
      {displayWallpapers.map((wallpaper, index) => (
        <a 
          href={`/${wallpaper.category.toLowerCase()}/${wallpaper.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}-${wallpaper.id}/`}
          class="wallpaper-card"
          data-category={wallpaper.category.toLowerCase()}
        >
          <div class="wallpaper-image-container">
            <img
              src={wallpaper.url}
              alt={wallpaper.alt_text || wallpaper.title}
              class="wallpaper-image"
              loading={index < 4 ? "eager" : "lazy"}
              decoding={index < 4 ? "sync" : "async"}
              width="400"
              height="225"
            />
            <div class="wallpaper-overlay">
              <span class="view-text">VIEW</span>
            </div>
          </div>
          <div class="wallpaper-info">
            <h3 class="wallpaper-title">{wallpaper.title}</h3>
            <div class="wallpaper-meta">
              <span class="category-badge">{wallpaper.category}</span>
              <span class="stats">
                ❤️ {wallpaper.likes} · ⬇️ {wallpaper.downloads}
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<script>
  // ASCII demo animation — real frames from 10s 2D animation video
  document.addEventListener('DOMContentLoaded', () => {
    const asciiFrames = [
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################+++#############%%%%%%%%%%%%%#\n####%%%%%%#######++%%%%%%%######################\n####%%%%%%%%%%%%====%%%%%%%%%%#######-#+-:-=====\n---*%%%%%%%%%%-.==%%%%%%%%%%%%%%%====----=------\n--=====:=%%%%%%==:%#==+-=====-=-======----------\n===++++++++***=-===========-====++++++++++++++==\n******************=*******%*%*******************\n***************..=******* *%@@@@****************\n*************+=::::-=+****+=====****************\n***********************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################-+:#############%%%%%%%%%%%%%#\n####%%%%%%#######++%#%%%%%######################\n####%%%%%%%%%%%%==+%%%%%%%%%%%#######-#+-:-=====\n---*%%%%%%%%%%-:=+=%%%%%%%%%%%%%%====---==------\n--=====:=%%%%%%==:%#==+-===+%= +======----------\n===++++++++***=-===========-% +@++++++++++++++==\n******************=*****************************\n***************:.=******************************\n*************+=::::-=+*****+++++****************\n***********************##******#################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%###############+++###############%%%%%%%%%%%%%#\n####%%%%%%######+..%%%%%%%######################\n####%%%%%%%%%%#==%%%%%-%%%%%%%#######-#+-:-=====\n--=*%%%%%%%%%-..==%=%%%%%%%%%%%%%====---==------\n--=====:=%%%%%===%%#==+======-==========--------\n===++++++++***=============-====++++++++++++++==\n****************=*=*****************************\n**************=**=****** .@@@@@%****************\n************+========*****+=====****************\n**********#************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################################%%%%%%%%%%%%%#\n%###%%%%%%#######%%+++.%%%######################\n####%%%%%%%%%%%%%%=.%=*%%%%%%%#######-#+-:-=====\n--=*%%%%%%%%%%.====.:%%%%%%%%%%%%====----=------\n--=====:=%%%%%====%%==+-=====-=-=-======--------\n===++++++++**===:==========-====++++++++++++++==\n*************.=***#=****************************\n***********=-****=******************************\n***********+=========***************************\n***********************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%#################################%%%%%%%%%%%%%#\n%###%%%%%%#######%%%+++%%%######################\n####%%%%%%%%%%%%%%:=.#+=.%%%%%#######-#+-:-=====\n--=*%%%%%%%%%%%=-==.%+:%%%%%%%%%%====----=------\n--=====:=%%%%%%====#+=+-=====-=-=-======--------\n===++++++++***===-=========-====++++++++++++++==\n**************=****=****************************\n***********==****=******************************\n************+========+**************************\n***********************###**####################",
      "##############%%%%%%%%%%###########%%%%@@@@@@@@@\n################################%%%%%%%%@@@@%%%%\n%############-+:##################%%%%%%%%%%%%%#\n%###%%%%%%###=+#%%%%%%%%%%######################\n####%%%%%%%===+%%%%%%%%%%%%%%%#######-#+-:-=====\n--=*%%%%%%%==:+%%%%%%%%%%%%%%%%%%====---==------\n--=====:=%%===%%%%%#+=+======-=-=-======--------\n===+++++++.=-==*++=========-====++++++++++++++==\n************=**-********************=*@ @*******\n**********==**+=********************** %@@@@****\n**********+=+++=++**********************+++*****\n***********************###**####################"
    ];
    const el = document.getElementById('ascii-demo');
    if (el) {
      let i = 0;
      setInterval(() => {
        i = (i + 1) % asciiFrames.length;
        el.textContent = asciiFrames[i];
      }, 400);
    }
  });

  // Client-side filtering
  document.addEventListener('DOMContentLoaded', () => {
    const filterBtns = document.querySelectorAll('.filter-btn');
    const wallpaperCards = document.querySelectorAll('.wallpaper-card');

    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.getAttribute('data-category');
        
        // Update active button
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        // Filter wallpapers
        wallpaperCards.forEach(card => {
          const cardCategory = card.getAttribute('data-category');
          if (category === 'all' || cardCategory === category) {
            card.style.display = 'block';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  });
</script>

<style>
  /* Hero Section */
  .hero {
    min-height: 50vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    background: linear-gradient(135deg, #050509 0%, #1a1a2e 100%);
    position: relative;
    overflow: hidden;
    border: 2px solid transparent;
    animation: neonBorder 3s infinite;
    margin: 20px;
    border-radius: 10px;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, #b026ff, #8a2be2, #9400d3);
    z-index: -1;
    border-radius: 12px;
    opacity: 0.7;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px;
    background: rgba(10, 10, 15, 0.8);
    border-radius: 8px;
    backdrop-filter: blur(5px);
    border: 1px solid rgba(138, 43, 226, 0.3);
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    background: linear-gradient(90deg, #b026ff, #8a2be2, #9400d3);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    margin: 0 0 1rem;
    line-height: 1.1;
    letter-spacing: -1px;
    text-shadow: 0 0 10px rgba(176, 38, 255, 0.3);
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: #a0a0a0;
    margin: 0;
    max-width: 600px;
    margin: 0 auto;
  }

  /* Tools Section */
  .tools-section {
    max-width: 1000px;
    margin: 24px auto 0;
    padding: 0 20px;
  }

  .tools-header {
    text-align: center;
    margin-bottom: 28px;
  }

  .tools-badge {
    display: inline-block;
    font-family: monospace;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 3px;
    color: #b026ff;
    border: 1px solid rgba(176,38,255,0.3);
    padding: 4px 14px;
    border-radius: 20px;
    margin-bottom: 12px;
    background: rgba(176,38,255,0.06);
  }

  .tools-title {
    font-size: clamp(1.4rem, 3vw, 2rem);
    font-weight: 900;
    color: #f0f0f0;
    margin: 0 0 8px;
    letter-spacing: -0.5px;
  }

  .tools-subtitle {
    font-size: 0.95rem;
    color: #666;
    margin: 0;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }

  /* Tool Card */
  .tool-card {
    display: flex;
    flex-direction: column;
    background: #0d0f14;
    border: 1px solid rgba(255,255,255,0.07);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: all 0.35s cubic-bezier(0.23, 1, 0.32, 1);
    position: relative;
  }

  .tool-card:hover {
    transform: translateY(-6px);
    border-color: rgba(255,255,255,0.15);
  }

  .tool-card--ascii:hover {
    box-shadow: 0 12px 40px rgba(57,255,20,0.12), 0 0 0 1px rgba(57,255,20,0.2);
  }

  .tool-card--vp:hover {
    box-shadow: 0 12px 40px rgba(0,243,255,0.12), 0 0 0 1px rgba(0,243,255,0.2);
  }

  /* Card Preview */
  .tool-card__preview {
    position: relative;
    height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #080a0f;
  }

  .tool-card__glow {
    position: absolute;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    filter: blur(80px);
    opacity: 0.15;
    pointer-events: none;
    transition: opacity 0.4s;
  }

  .tool-card:hover .tool-card__glow { opacity: 0.3; }

  .tool-card__glow--green {
    background: #39ff14;
    top: -40px;
    right: -40px;
  }

  .tool-card__glow--cyan {
    background: #00f3ff;
    top: -40px;
    left: -40px;
  }

  /* ASCII Demo — real video frames */
  .ascii-demo {
    font-family: 'Courier New', Courier, monospace;
    font-size: 7.5px;
    line-height: 1.15;
    letter-spacing: 0.5px;
    color: #39ff14;
    text-align: center;
    margin: 0;
    padding: 0;
    background: none;
    border: none;
    white-space: pre;
    opacity: 0.65;
    transition: opacity 0.3s, text-shadow 0.3s;
    overflow: hidden;
    text-shadow: 0 0 2px rgba(57,255,20,0.3);
  }

  .tool-card--ascii:hover .ascii-demo {
    opacity: 1;
    text-shadow: 0 0 6px rgba(57,255,20,0.5);
  }

  /* VP Preview Mock */
  .vp-preview-mock {
    width: 80%;
    max-width: 260px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    opacity: 0.7;
    transition: opacity 0.3s;
  }

  .tool-card--vp:hover .vp-preview-mock { opacity: 1; }

  .vp-bar-group {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .vp-label {
    font-family: monospace;
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: #555;
  }

  .vp-bar {
    height: 6px;
    background: rgba(255,255,255,0.06);
    border-radius: 3px;
    overflow: hidden;
  }

  .vp-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #00f3ff, #0088ff);
    border-radius: 3px;
    transition: width 1s cubic-bezier(0.23, 1, 0.32, 1);
  }

  /* Card Body */
  .tool-card__body {
    padding: 20px 22px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    flex: 1;
  }

  .tool-card__tag {
    font-family: monospace;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    width: fit-content;
    padding: 3px 10px;
    border-radius: 4px;
  }

  .tool-card__tag--green {
    color: #39ff14;
    background: rgba(57,255,20,0.08);
    border: 1px solid rgba(57,255,20,0.15);
  }

  .tool-card__tag--cyan {
    color: #00f3ff;
    background: rgba(0,243,255,0.08);
    border: 1px solid rgba(0,243,255,0.15);
  }

  .tool-card__title {
    font-size: 1.3rem;
    font-weight: 900;
    color: #f0f0f0;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .tool-card__desc {
    font-size: 0.82rem;
    color: #666;
    line-height: 1.5;
    margin: 0;
    flex: 1;
  }

  .tool-card__cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 800;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-top: 8px;
    transition: gap 0.3s;
  }

  .tool-card:hover .tool-card__cta { gap: 10px; }

  .tool-card__cta--green { color: #39ff14; }
  .tool-card__cta--cyan { color: #00f3ff; }

  @media (max-width: 640px) {
    .tools-grid {
      grid-template-columns: 1fr;
    }

    .tool-card__preview {
      height: 140px;
    }
  }

  /* Filters Section */
  .filters-section {
    max-width: 1400px;
    margin: 40px auto 20px;
    padding: 0 20px;
  }

  .filters-container {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .filter-btn {
    background: #121218;
    color: #f0f0f0;
    border: 3px solid #00fff9;
    padding: 12px 24px;
    font-size: 0.9rem;
    font-weight: 900;
    text-transform: uppercase;
    cursor: pointer;
    transition: all 0.3s ease;
    border-radius: 6px;
    box-shadow: 0 0 15px rgba(0, 255, 249, 0.3);
  }

  .filter-btn:hover {
    background: #00fff9;
    color: #0a0a0f;
    transform: translateY(-2px);
    box-shadow: 0 0 25px rgba(0, 255, 249, 0.6);
  }

  .filter-btn.active {
    background: linear-gradient(135deg, #b026ff, #8a2be2);
    border-color: #b026ff;
    color: white;
    box-shadow: 0 0 25px rgba(176, 38, 255, 0.6);
  }

  /* Wallpapers Section */
  .wallpapers-section {
    max-width: 1400px;
    margin: 40px auto;
    padding: 0 20px;
  }

  .wallpapers-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
  }

  .wallpaper-card {
    background: #121218;
    border: 3px solid #00fff9;
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s ease;
    text-decoration: none;
    color: inherit;
    box-shadow: 0 0 20px rgba(0, 255, 249, 0.3);
  }

  .wallpaper-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 0 40px rgba(0, 255, 249, 0.6),
                0 10px 30px rgba(0, 0, 0, 0.5);
    border-color: #b026ff;
  }

  .wallpaper-image-container {
    position: relative;
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .wallpaper-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .wallpaper-card:hover .wallpaper-image {
    transform: scale(1.1);
  }

  .wallpaper-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .wallpaper-card:hover .wallpaper-overlay {
    opacity: 1;
  }

  .view-text {
    color: #00fff9;
    font-size: 1.5rem;
    font-weight: 900;
    text-shadow: 0 0 10px #00fff9;
  }

  .wallpaper-info {
    padding: 16px;
  }

  .wallpaper-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #f0f0f0;
    margin: 0 0 8px 0;
    text-transform: uppercase;
  }

  .wallpaper-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  .category-badge {
    background: linear-gradient(135deg, #b026ff, #8a2be2);
    color: white;
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .stats {
    color: #a0a0a0;
    font-size: 0.85rem;
    font-weight: 600;
  }

  @media (max-width: 768px) {
    .wallpapers-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }

    .wallpaper-image-container {
      height: 240px;
    }

    .filters-container {
      gap: 8px;
    }

    .filter-btn {
      padding: 10px 16px;
      font-size: 0.8rem;
    }
  }
</style>
