---
export const prerender = true;
import AppLayout from '../layouts/AppLayout.astro';
import Svg3DLab from '../components/Svg3DLab';

const title = '3D Lab — Turn text & SVG into 3D | CrackingWall';
const description = 'Turn any text or SVG into an interactive 3D object right in your browser. Pick a material preset, drag to orbit. Free, client-side.';
---

<AppLayout title={title} description={description}>
  <!-- Compact hero -->
  <section class="mb-6 border-2 border-black bg-brutal-dark-bg px-6 py-5 shadow-brutal md:px-8">
    <p class="mb-1.5 font-mono text-[10px] uppercase tracking-[0.3em] text-brutal-neon-purple">Labs / 3D Lab</p>
    <h1 class="font-brutal text-2xl font-black uppercase tracking-tight text-white md:text-3xl">
      Text &amp; SVG → <span class="text-brutal-neon-cyan">3D</span>
    </h1>
    <p class="mt-2 font-mono text-xs text-gray-400">Interactive 3D in the browser · pick a preset · drag to orbit.</p>
  </section>

  <Svg3DLab client:only="react" />
</AppLayout>
