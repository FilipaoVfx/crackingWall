---
export const prerender = true;
import AppLayout from '../../layouts/AppLayout.astro';
import { WallpaperService } from '../../services/wallpaperService';
import { wallpaperSlug, wallpaperPath } from '../../utils/wallpaper';
import { Download, ArrowLeft, Layers, Monitor, Heart, ExternalLink, Link2 } from 'lucide-react';

export async function getStaticPaths() {
  const wallpapers = await WallpaperService.getAllWallpapers();

  return wallpapers.map((wallpaper) => {
    return {
      params: {
        category: (wallpaper.category || 'uncategorized').toLowerCase(),
        slug: wallpaperSlug(wallpaper),
      },
      props: { wallpaper },
    };
  });
}

const { wallpaper } = Astro.props;

if (!wallpaper) {
  return Astro.redirect('/404');
}

const allWallpapers = await WallpaperService.getAllWallpapers();
const relatedWallpapers = allWallpapers
  .filter((w) => w.category === wallpaper.category && w.id !== wallpaper.id)
  .slice(0, 4);

const title = `${wallpaper.title} Wallpaper | Pixelatmos`;
const description = `Download ${wallpaper.title} as a premium digital background. ${wallpaper.description}`;
const canonicalUrl = Astro.url.href;

const resolution = wallpaper.width && wallpaper.height ? `${wallpaper.width}×${wallpaper.height}` : 'HD';
const format = (wallpaper.format || 'jpg').toUpperCase();

const imageObjectSchema = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  name: wallpaper.title,
  description: wallpaper.description,
  contentUrl: wallpaper.url,
  thumbnailUrl: wallpaper.url,
  width: { '@type': 'QuantitativeValue', value: wallpaper.width || 3840 },
  height: { '@type': 'QuantitativeValue', value: wallpaper.height || 2160 },
  encodingFormat: `image/${wallpaper.format || 'jpeg'}`,
  keywords: wallpaper.tags?.join(', ') || wallpaper.category,
  license: 'https://pixelatmos.com/license',
  acquireLicensePage: 'https://pixelatmos.com/license',
  creator: { '@type': 'Organization', name: 'Pixelatmos', url: 'https://pixelatmos.com' },
  creditText: 'Pixelatmos — FilipaoVfx',
  copyrightNotice: `© ${new Date().getFullYear()} Pixelatmos (FilipaoVfx)`,
  interactionStatistic: [
    { '@type': 'InteractionCounter', interactionType: 'https://schema.org/DownloadAction', userInteractionCount: wallpaper.downloads || 0 },
    { '@type': 'InteractionCounter', interactionType: 'https://schema.org/LikeAction', userInteractionCount: wallpaper.likes || 0 },
  ],
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://pixelatmos.com/' },
    { '@type': 'ListItem', position: 2, name: wallpaper.category, item: `https://pixelatmos.com/${wallpaper.category.toLowerCase()}/` },
    { '@type': 'ListItem', position: 3, name: wallpaper.title },
  ],
};

const chip = 'flex items-center gap-1.5 border-2 border-white/15 px-3 py-1.5 font-mono text-[11px] font-bold uppercase tracking-wide text-gray-300';
---

<AppLayout title={title} description={description} image={wallpaper.url}>
  <script type="application/ld+json" set:html={JSON.stringify(imageObjectSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="mx-auto max-w-6xl">
    <!-- Back link -->
    <a
      href={`/${wallpaper.category.toLowerCase()}/`}
      class="group inline-flex items-center gap-2 font-mono text-xs font-bold uppercase tracking-wide text-gray-400 transition-colors hover:text-brutal-neon-cyan"
    >
      <ArrowLeft className="h-4 w-4 transition-transform group-hover:-translate-x-1" />
      {wallpaper.category}
    </a>

    <!-- Hero image -->
    <div class="mt-5 border-2 border-black bg-brutal-dark-bg p-2 shadow-brutal">
      <div class="aspect-video w-full overflow-hidden">
        <img
          src={wallpaper.url}
          alt={wallpaper.alt_text || wallpaper.title}
          class="h-full w-full object-cover"
          width={wallpaper.width || 3840}
          height={wallpaper.height || 2160}
          loading="eager"
          decoding="async"
          fetchpriority="high"
          transition:name={`wallpaper-${wallpaper.id}`}
        />
      </div>
    </div>

    <!-- Details + actions -->
    <div class="mt-8 grid grid-cols-1 gap-8 lg:grid-cols-3">
      <!-- Left: title, description, meta -->
      <div class="lg:col-span-2">
        <h1 class="font-brutal text-3xl font-black uppercase leading-tight tracking-tight text-white md:text-4xl">
          {wallpaper.title}
        </h1>
        {wallpaper.description && (
          <p class="mt-4 max-w-2xl border-l-2 border-brutal-neon-pink pl-4 font-mono text-sm leading-relaxed text-gray-400">
            {wallpaper.description}
          </p>
        )}

        <div class="mt-6 flex flex-wrap gap-2">
          <span class={chip}><Layers className="h-3.5 w-3.5 text-brutal-neon-cyan" />{wallpaper.category}</span>
          <span class={chip}><Monitor className="h-3.5 w-3.5 text-brutal-neon-cyan" />{resolution}</span>
          <span class={chip}>{format}</span>
          <span class={chip}><Heart className="h-3.5 w-3.5 text-brutal-neon-pink" />{wallpaper.likes ?? 0}</span>
          <span class={chip}><Download className="h-3.5 w-3.5 text-brutal-neon-green" />{wallpaper.downloads ?? 0}</span>
        </div>
      </div>

      <!-- Right: action panel -->
      <div class="space-y-3 lg:sticky lg:top-24 lg:self-start">
        <!-- Primary download -->
        <button
          id="download-btn"
          data-url={wallpaper.url}
          data-id={wallpaper.id}
          data-filename={`pixelatmos-${wallpaper.id}.${wallpaper.format || 'jpg'}`}
          class="relative w-full overflow-hidden border-2 border-black bg-brutal-neon-green py-4 font-brutal text-sm font-black uppercase tracking-wide text-black shadow-brutal-sm transition-transform hover:-translate-y-0.5"
        >
          <span class="flex items-center justify-center gap-2">
            <Download className="h-4 w-4" />
            <span id="btn-label">Descargar</span>
          </span>
          <span class="btn-progress absolute bottom-0 left-0 h-1 bg-black/40" style="width:0%"></span>
        </button>

        <!-- Secondary actions -->
        <div class="grid grid-cols-2 gap-3">
          <a
            href={wallpaper.url}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center gap-2 border-2 border-white/15 py-3 font-brutal text-xs font-black uppercase tracking-wide text-gray-300 transition-colors hover:border-brutal-neon-cyan hover:text-brutal-neon-cyan"
          >
            <ExternalLink className="h-4 w-4" /> Ver full
          </a>
          <button
            id="copy-link"
            class="flex items-center justify-center gap-2 border-2 border-white/15 py-3 font-brutal text-xs font-black uppercase tracking-wide text-gray-300 transition-colors hover:border-brutal-neon-cyan hover:text-brutal-neon-cyan"
          >
            <Link2 className="h-4 w-4" /> <span id="copy-label">Copiar</span>
          </button>
        </div>

        <p class="text-center font-mono text-[10px] uppercase tracking-widest text-gray-600">
          Free for personal &amp; commercial use · <a href="/license" class="underline hover:text-brutal-neon-cyan">License</a>
        </p>
      </div>
    </div>

    <!-- Related -->
    {relatedWallpapers.length > 0 && (
      <section class="mt-16">
        <div class="mb-5 flex items-end justify-between">
          <h2 class="font-brutal text-xl font-black uppercase tracking-tight text-white">Related Wallpapers</h2>
          <a href={`/${wallpaper.category.toLowerCase()}/`} class="font-mono text-[11px] uppercase tracking-wide text-brutal-neon-purple hover:underline">More in {wallpaper.category} →</a>
        </div>
        <div class="grid grid-cols-2 gap-4 lg:grid-cols-4">
          {relatedWallpapers.map((related) => {
            return (
              <a
                href={wallpaperPath(related)}
                class="group overflow-hidden border-2 border-black bg-brutal-dark-bg shadow-brutal-sm transition-all hover:-translate-y-1 hover:shadow-neon-purple"
              >
                <div class="relative aspect-video overflow-hidden border-b-2 border-black">
                  <img
                    src={related.url}
                    alt={related.alt_text || related.title}
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                    decoding="async"
                    width={related.width || 400}
                    height={related.height || 225}
                  />
                </div>
                <div class="flex items-center justify-between gap-2 px-3 py-2">
                  <h3 class="truncate font-brutal text-[11px] font-bold uppercase tracking-wide text-white">{related.title}</h3>
                  <Layers className="h-3.5 w-3.5 shrink-0 text-brutal-neon-cyan" />
                </div>
              </a>
            );
          })}
        </div>
      </section>
    )}
  </div>
</AppLayout>

<script>
  const downloadBtn = document.getElementById('download-btn');
  const btnLabel = document.getElementById('btn-label');
  const progress = document.querySelector('.btn-progress') as HTMLElement | null;

  if (downloadBtn && btnLabel && progress) {
    downloadBtn.addEventListener('click', async () => {
      const url = downloadBtn.getAttribute('data-url');
      const id = downloadBtn.getAttribute('data-id');
      const filename = downloadBtn.getAttribute('data-filename') || 'wallpaper.jpg';
      if (!url) return;

      (downloadBtn as HTMLButtonElement).disabled = true;
      btnLabel.textContent = 'Descargando…';
      progress.style.width = '30%';

      // Best-effort download tracking (non-blocking)
      if (id) {
        const { WallpaperService } = await import('../../services/wallpaperService');
        WallpaperService.incrementWallpaperDownloads(id).catch(() => {});
      }

      try {
        const res = await fetch(url);
        if (!res.ok) throw new Error('fetch failed');
        progress.style.width = '100%';
        const blob = await res.blob();
        const blobUrl = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = blobUrl;
        a.download = filename;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(blobUrl);
        btnLabel.textContent = '¡Listo!';
      } catch {
        // Fallback: open in a new tab
        window.open(url, '_blank', 'noopener');
        btnLabel.textContent = 'Abierto en pestaña';
      } finally {
        setTimeout(() => {
          btnLabel.textContent = 'Descargar';
          progress.style.width = '0%';
          (downloadBtn as HTMLButtonElement).disabled = false;
        }, 1500);
      }
    });
  }

  // Copy link
  const copyBtn = document.getElementById('copy-link');
  const copyLabel = document.getElementById('copy-label');
  if (copyBtn && copyLabel) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyLabel.textContent = '¡Copiado!';
      } catch {
        copyLabel.textContent = 'Error';
      }
      setTimeout(() => { copyLabel.textContent = 'Copiar'; }, 1500);
    });
  }
</script>
