---
import Sidebar from '../components/layout/Sidebar.astro';
import { AppTopBar } from '../components/layout/AppTopBar';
import '../index.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = 'Creative tools for analyzing visuals, generating ideas and building experiences. Free, browser-based.',
  image = '/og-image.webp',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteURL = Astro.site?.toString().replace(/\/$/, '') ?? 'https://crakingculturewallpaperr.xyz';

// Site-wide structured data (Organization + WebSite) for SEO / E-E-A-T signals.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteURL}/#organization`,
      name: 'CrackingWall',
      alternateName: 'CrakingWall',
      url: `${siteURL}/`,
      logo: {
        '@type': 'ImageObject',
        url: `${siteURL}/og-image.webp`,
      },
      description:
        'CrackingWall is an independent creative-tools studio and curated gallery for tech-culture visuals — browser-based tools (ASCII Lab, Visual Protocol, 3D Lab) plus original cyberpunk and developer-culture wallpapers.',
      foundingDate: '2024',
      sameAs: ['https://github.com/FilipaoVfx'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteURL}/#website`,
      url: `${siteURL}/`,
      name: 'CrackingWall',
      description:
        'Free, browser-based creative tools and a curated gallery of tech-culture wallpapers.',
      inLanguage: 'en',
      publisher: { '@id': `${siteURL}/#organization` },
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1028294908787451"
     crossorigin="anonymous"></script>
    <link rel="icon" type="image/x-icon" href="/iconCulture.ico" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Site-wide structured data (Organization + WebSite) -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="twitter:card" content="summary_large_image" />

    <title>{title}</title>
  </head>
  <body>
    <Sidebar />

    <div class="app-content ml-[260px] min-h-screen transition-[margin] duration-200">
      <AppTopBar client:load />
      <main class="px-6 py-8 md:px-10">
        <slot />
      </main>

      <footer class="border-t-2 border-white/10 px-6 py-10 text-center md:px-10">
        <div class="mb-6 flex flex-wrap justify-center gap-x-6 gap-y-2 font-brutal text-xs font-black uppercase tracking-wider">
          <a href="/" class="text-gray-400 transition-colors hover:text-brutal-neon-cyan">Home</a>
          <a href="/ascii-lab/" class="text-gray-400 transition-colors hover:text-brutal-neon-green">ASCII Lab</a>
          <a href="/visual-protocol/" class="text-gray-400 transition-colors hover:text-brutal-neon-pink">Visual Protocol</a>
          <a href="/3d-lab/" class="text-gray-400 transition-colors hover:text-brutal-neon-yellow">3D Lab</a>
          <a href="/wallpapers/" class="text-gray-400 transition-colors hover:text-brutal-neon-purple">Wallpapers</a>
          <a href="/blog/" class="text-gray-400 transition-colors hover:text-brutal-neon-cyan">Blog</a>
          <a href="/about/" class="text-gray-400 transition-colors hover:text-brutal-neon-cyan">About</a>
          <a href="/contact/" class="text-gray-400 transition-colors hover:text-brutal-neon-yellow">Contact</a>
          <a href="/license" class="text-gray-400 transition-colors hover:text-brutal-neon-green">License</a>
          <a href="/privacy-policy" class="text-gray-400 transition-colors hover:text-brutal-neon-green">Privacy</a>
          <a href="/terms" class="text-gray-400 transition-colors hover:text-brutal-neon-green">Terms</a>
        </div>
        <div class="mx-auto mb-4 h-1 w-20 bg-brutal-neon-cyan"></div>
        <p class="font-mono text-xs text-gray-500">
          &copy; {new Date().getFullYear()} <span class="text-white">CrakingWall</span>. Protocol initialized.
        </p>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    background: #0a0a0f;
    color: #f0f0f0;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }
</style>
