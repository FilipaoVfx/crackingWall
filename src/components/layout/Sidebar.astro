---
// Persistent app sidebar — neobrutalism refined.
// Only real, shipped tools are listed (future tools hidden until built).
const { pathname } = Astro.url;

// Normalize trailing slashes for active-state matching
const norm = (p: string) => (p !== '/' && p.endsWith('/') ? p.slice(0, -1) : p);
const current = norm(pathname);
const isActive = (href: string) => current === norm(href);

type NavItem = { label: string; href: string; accent: string; icon: string };

const tools: NavItem[] = [
  { label: 'Home', href: '/', accent: 'cyan', icon: 'grid' },
  { label: 'ASCII Lab', href: '/ascii-lab/', accent: 'green', icon: 'terminal' },
  { label: 'Visual Protocol', href: '/visual-protocol/', accent: 'pink', icon: 'scan' },
  { label: '3D Lab', href: '/3d-lab/', accent: 'yellow', icon: 'cube' },
];

const library: NavItem[] = [
  { label: 'Wallpapers', href: '/wallpapers/', accent: 'purple', icon: 'image' },
];

// Accent -> active background color (neon tokens)
const accentBg: Record<string, string> = {
  cyan: 'bg-brutal-neon-cyan',
  green: 'bg-brutal-neon-green',
  pink: 'bg-brutal-neon-pink',
  purple: 'bg-brutal-neon-purple',
  yellow: 'bg-brutal-neon-yellow',
};
const accentText: Record<string, string> = {
  cyan: 'hover:text-brutal-neon-cyan',
  green: 'hover:text-brutal-neon-green',
  pink: 'hover:text-brutal-neon-pink',
  purple: 'hover:text-brutal-neon-purple',
  yellow: 'hover:text-brutal-neon-yellow',
};

// Inline SVG icon helper (stroke-based, matches lucide weight)
function iconSvg(name: string): string {
  const base = 'xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"';
  const paths: Record<string, string> = {
    grid: '<rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>',
    terminal: '<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>',
    scan: '<path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="3" y1="12" x2="21" y2="12"/>',
    image: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.5-3.5L9 20"/>',
    cube: '<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/>',
  };
  return `<svg ${base}>${paths[name] || paths.grid}</svg>`;
}
---

<aside
  id="app-sidebar"
  class="app-sidebar fixed top-0 left-0 z-40 flex h-screen w-[260px] flex-col border-r-4 border-brutal-neon-cyan bg-brutal-dark-deeper transition-[width] duration-200"
>
  <!-- Brand -->
  <div class="flex items-center gap-3 border-b-2 border-white/10 px-5 py-5">
    <a href="/" class="flex items-center gap-3 group">
      <span
        class="grid h-9 w-9 shrink-0 place-items-center border-2 border-black bg-brutal-neon-cyan font-brutal text-lg font-black text-black shadow-brutal-sm"
        >C</span
      >
      <span class="sidebar-label leading-tight">
        <span class="block font-brutal text-base font-black tracking-tight text-white">CRACKINGWALL</span>
        <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-gray-500">Creative Tools Lab</span>
      </span>
    </a>
    <button
      id="sidebar-toggle"
      aria-label="Toggle sidebar"
      class="ml-auto grid h-7 w-7 place-items-center border-2 border-white/15 text-gray-400 transition-colors hover:border-brutal-neon-cyan hover:text-brutal-neon-cyan"
    >
      <svg id="sidebar-toggle-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
    </button>
  </div>

  <!-- Nav -->
  <nav class="flex-1 overflow-y-auto px-3 py-5">
    <p class="sidebar-label mb-2 px-3 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-gray-600">Tools</p>
    <ul class="mb-6 space-y-1">
      {tools.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'group flex items-center gap-3 border-2 px-3 py-2.5 font-brutal text-sm font-bold uppercase tracking-wide transition-all',
              isActive(item.href)
                ? `${accentBg[item.accent]} border-black text-black shadow-brutal-sm`
                : `border-transparent text-gray-300 hover:bg-white/5 ${accentText[item.accent]}`,
            ]}
          >
            <span class="shrink-0" set:html={iconSvg(item.icon)} />
            <span class="sidebar-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>

    <p class="sidebar-label mb-2 px-3 font-mono text-[10px] font-bold uppercase tracking-[0.2em] text-gray-600">Library</p>
    <ul class="space-y-1">
      {library.map((item) => (
        <li>
          <a
            href={item.href}
            class:list={[
              'group flex items-center gap-3 border-2 px-3 py-2.5 font-brutal text-sm font-bold uppercase tracking-wide transition-all',
              isActive(item.href)
                ? `${accentBg[item.accent]} border-black text-black shadow-brutal-sm`
                : `border-transparent text-gray-300 hover:bg-white/5 ${accentText[item.accent]}`,
            ]}
          >
            <span class="shrink-0" set:html={iconSvg(item.icon)} />
            <span class="sidebar-label">{item.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Footer -->
  <div class="border-t-2 border-white/10 px-5 py-4">
    <span class="sidebar-label font-mono text-[10px] uppercase tracking-[0.2em] text-gray-600">v1.0 · protocol</span>
  </div>
</aside>

<script is:inline>
  (function () {
    const KEY = 'cw-sidebar-collapsed';
    const root = document.documentElement;
    const apply = (collapsed) => root.classList.toggle('sidebar-collapsed', collapsed);
    apply(localStorage.getItem(KEY) === '1');
    const btn = document.getElementById('sidebar-toggle');
    btn &&
      btn.addEventListener('click', () => {
        const collapsed = !root.classList.contains('sidebar-collapsed');
        apply(collapsed);
        localStorage.setItem(KEY, collapsed ? '1' : '0');
      });
  })();
</script>

<style is:global>
  /* Collapsed state: shrink sidebar, hide labels, push content */
  html.sidebar-collapsed #app-sidebar { width: 72px; }
  html.sidebar-collapsed .sidebar-label { display: none; }
  html.sidebar-collapsed #sidebar-toggle-icon { transform: rotate(180deg); }
  html.sidebar-collapsed .app-content { margin-left: 72px; }
</style>
