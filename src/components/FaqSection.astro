---
// Reusable FAQ block: renders an accessible <details> accordion AND emits
// FAQPage JSON-LD (strong signal for AI answer engines / Google rich results).
interface FaqItem {
  q: string;
  a: string;
}
interface Props {
  items: FaqItem[];
  heading?: string;
}
const { items, heading = 'Frequently asked questions' } = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="mx-auto mt-12 max-w-3xl">
  <h2 class="mb-5 font-brutal text-xl font-black uppercase tracking-tight text-white">{heading}</h2>
  <div class="flex flex-col gap-3">
    {items.map((it) => (
      <details class="group border-2 border-black bg-brutal-dark-bg shadow-brutal-sm">
        <summary class="flex cursor-pointer items-center justify-between gap-4 px-4 py-3 font-brutal text-sm font-black uppercase tracking-wide text-white marker:content-none">
          {it.q}
          <span class="font-mono text-brutal-neon-cyan transition-transform group-open:rotate-45">+</span>
        </summary>
        <p class="border-t-2 border-black/60 px-4 py-3 font-mono text-[13px] leading-relaxed text-gray-400">
          {it.a}
        </p>
      </details>
    ))}
  </div>
</section>

<style>
  summary::-webkit-details-marker { display: none; }
</style>
