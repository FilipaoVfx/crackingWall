---
/**
 * Breadcrumb trail — emits the visible nav AND BreadcrumbList JSON-LD in one
 * pass, so the markup and the structured data can never disagree.
 *
 * The last item is the current page: rendered as plain text (not a link) and
 * emitted without an `item` URL, per schema.org guidance.
 *
 * Usage:
 *   <Breadcrumbs items={[{ name: 'Labs' }, { name: '3D Lab' }]} />
 * "Home" is prepended automatically.
 */
const SITE = 'https://pixelatmos.com';

export interface Crumb {
  name: string;
  /** Absolute path (e.g. "/wallpapers/"). Omit for the current page. */
  href?: string;
}

interface Props {
  items: Crumb[];
  class?: string;
}

const { items, class: className = '' } = Astro.props;

const trail: Crumb[] = [{ name: 'Home', href: '/' }, ...items];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: trail.map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    // The current page (no href) carries no `item` — it is where you already are.
    ...(c.href ? { item: `${SITE}${c.href}` } : {}),
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />

<nav aria-label="Breadcrumb" class={`mb-4 ${className}`}>
  <ol class="flex flex-wrap items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.15em] text-gray-500">
    {trail.map((c, i) => (
      <li class="flex items-center gap-1.5">
        {i > 0 && <span aria-hidden="true" class="text-gray-700">/</span>}
        {c.href ? (
          <a href={c.href} class="transition-colors hover:text-brutal-neon-cyan">{c.name}</a>
        ) : (
          <span aria-current="page" class="text-gray-300">{c.name}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
